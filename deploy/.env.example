# Copy to .env (chmod 600) and fill in. See HOWTO.md section 4 for how to
# choose each value; wrong IP/protocol choices fail silently at stream time.
SELKIES_IMAGE=ghcr.io/selkies-project/selkies-gstreamer/gst-py-example:latest-ubuntu24.04
SELKIES_BASIC_AUTH_USER=changeme
SELKIES_BASIC_AUTH_PASSWORD=changeme-long-random

# GPU with the most FREE VRAM (not lowest utilization) -- WebGL dies on OOM.
SELKIES_GPU_INDEX=0

# A100/H100 have no NVENC hardware encoder; keep software x264.
SELKIES_ENCODER=x264enc

# The host IP that client laptops can route to (ethernet, not InfiniBand).
# Re-check after any network re-addressing.
SELKIES_TURN_HOST=10.0.0.1
SELKIES_TURN_PORT=3478
# tcp if client subnets have no UDP path to the host (common in offices).
SELKIES_TURN_PROTOCOL=tcp
TURN_EXTERNAL_IP=10.0.0.1
# REQUIRED on multi-homed hosts: bind relays where they are advertised,
# otherwise media black-holes (coturn logs show peer rp=0, rb=0).
TURN_EXTRA_ARGS=--relay-ip=10.0.0.1
