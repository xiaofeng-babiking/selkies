# CPU-only selkies + supersplat site config — copy to .env, edit, chmod 600.
# For hosts WITHOUT an NVIDIA GPU/driver; pairs with docker-compose.cpu.yml.

SELKIES_IMAGE=ghcr.io/selkies-project/selkies-gstreamer/gst-py-example:latest-ubuntu24.04

# Web login shown by the browser auth prompt.
SELKIES_BASIC_AUTH_USER=jing
SELKIES_BASIC_AUTH_PASSWORD=change-me

# Host paths: built SuperSplat checkout (must contain dist/) and the
# persistent scene dir (appears as ~/Documents in the desktop).
SUPERSPLAT_DIST_DIR=/home/you/codebases/supersplat
SELKIES_DATA_DIR=/home/you/selkies-data
# Bulk splat data, mounted read-only at ~/datasets in the desktop.
DATASETS_DIR=/home/you/datasets

# The host IP that client laptops can actually route to — on multi-homed
# hosts the ethernet interface, not IB/management (HOWTO §4.1–4.2).
SELKIES_TURN_HOST=10.0.0.1
TURN_EXTERNAL_IP=10.0.0.1
TURN_EXTRA_ARGS=--relay-ip=10.0.0.1
SELKIES_TURN_PORT=3478
# tcp unless you have verified a UDP path end to end (HOWTO §4.3).
SELKIES_TURN_PROTOCOL=tcp

# Stream footprint: 60/8000 on clean networks, 15/4000 on lossy ones.
SELKIES_FRAMERATE=30
SELKIES_VIDEO_BITRATE=8000
